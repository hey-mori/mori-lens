{
  "productName": "Mori Lens",
  "version": "0.1.0",
  "identifier": "dev.swarea.mori-lens",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mori Lens",
        "width": 800,
        "height": 600,
        "visible": false
      },
      {
        "label": "detail",
        "title": "Mori Lens · Detail",
        "width": 480,
        "height": 400,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  }
}
