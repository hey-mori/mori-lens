{
  "productName": "Mori Lens",
  "version": "0.1.0",
  "identifier": "dev.swarea.mori-lens",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mori Lens",
        "width": 800,
        "height": 600,
        "visible": false
      },
      {
        "label": "detail",
        "title": "Mori Lens · Detail",
        "width": 480,
        "height": 400,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app"],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "windows/nsis/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.3",
      "exceptionDomain": "",
      "signingIdentity": null,
      "entitlements": null
    }
  }
}
