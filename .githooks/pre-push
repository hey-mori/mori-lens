#!/usr/bin/env bash
#
# Reject pushes that violate the workflow contract.
#
# Two rules:
#   1. Direct pushes to refs/heads/main are forbidden.
#      All changes to main go through pull requests.
#   2. Non-fast-forward pushes to any branch are forbidden.
#      An autonomous agent must never force-push a published branch.
#
# See docs/git-workflow.md §6.
#
# Install via: scripts/setup-git-hooks.sh
set -euo pipefail

ZERO="0000000000000000000000000000000000000000"

while read -r local_ref local_sha remote_ref remote_sha; do
  # Rule 1: reject direct pushes to main.
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "ERROR: direct pushes to main are forbidden."
    echo "All changes to main go through a pull request."
    echo "See docs/git-workflow.md §6."
    exit 1
  fi

  # Skip new branches (remote has no ref yet).
  if [ "$remote_sha" = "$ZERO" ]; then
    continue
  fi

  # Skip branch deletions (local ref is zero).
  if [ "$local_sha" = "$ZERO" ]; then
    continue
  fi

  # Rule 2: reject non-fast-forward pushes.
  # A push is fast-forward when remote_sha is an ancestor of local_sha.
  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "ERROR: non-fast-forward push rejected for $remote_ref."
    echo "Autonomous agents must never force-push a published branch."
    echo "See docs/git-workflow.md §6."
    exit 1
  fi
done

exit 0
